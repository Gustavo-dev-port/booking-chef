# expo-router traz @expo/ui (devtools opcional) que puxa vaul/@radix-ui,
# que pedem react-dom numa faixa que não bate com o react 19.2.3 fixado
# no package.json (react-dom nem é usado em runtime nativo, só nas
# ferramentas de dev web do expo-router). Sem isso, tanto `npm install`
# local quanto o `npm ci` do EAS Build falham com ERESOLVE.
legacy-peer-deps=true
