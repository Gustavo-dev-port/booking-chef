{
  "expo": {
    "name": "mobile",
    "slug": "bookingchef",
    "version": "0.0.1",
    "scheme": "bookingchef",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorize o acesso às fotos para adicionar uma imagem à ficha.",
          "cameraPermission": "Autorize o acesso à câmera para tirar uma foto da ficha."
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.barujiru.bookingchef",
      "supportsTablet": true
    },
    "android": {
      "package": "com.barujiru.bookingchef",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7617f26f-5d2a-4c1f-bd0c-5c5dc71e33f9"
      }
    },
    "owner": "barujiru"
  }
}
